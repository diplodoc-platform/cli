{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "~/*": ["./src/*"],
      "@diplodoc/cli/lib/*": ["./src/core/*"],
      "@diplodoc/cli": ["./src"]
    },
    "plugins": [
      { "transform": "typescript-transform-paths", "afterDeclarations": true }
    ],
    "declaration": true,
    "noEmitOnError": false,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "build"
  },
  "include": [
    "src/path.d.ts",
    "src/globals.d.ts",
    "src"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/core/**",
    "src/extensions/**",
  ]
}
