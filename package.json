{
  "name": "@diplodoc/cli",
  "version": "5.64.0",
  "description": "Make documentation using yfm-docs in Markdown and HTML formats",
  "keywords": [
    "markdown",
    "yandex",
    "docs",
    "yfm",
    "documentation",
    "tool",
    "tools",
    "generator"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:diplodoc-platform/cli.git"
  },
  "license": "MIT",
  "author": "Yandex Data UI Team <data-ui@yandex-team.ru>",
  "typings": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "node": "./build/index.js",
      "default": "./build/index.mjs"
    },
    "./lib/*": {
      "types": "./lib/*/index.d.ts",
      "node": "./lib/*/index.js",
      "default": "./lib/*/index.mjs"
    },
    "./package": "./package.json",
    "./manifest": "./build/manifest.json",
    "./mdit-plugins": "./build/mdit-plugins.js",
    "./arcadia-vcs": "./build/arcadia-vcs.js",
    "./github-vcs": "./build/github-vcs.js",
    "./tests/fixtures": "./tests/fixtures/index.ts"
  },
  "main": "build/index.js",
  "bin": {
    "docs": "build/index.js",
    "yfm": "build/index.js"
  },
  "files": [
    "lib",
    "build",
    "assets",
    "tests",
    "!tests/e2e/translate-eval.spec.ts",
    "!tests/eval",
    "vitest.integration.config.ts",
    "dependency-train"
  ],
  "scripts": {
    "build": "npm run build:clean && node scripts/build.cli.js",
    "build:types": "tspc -p tsconfig.lib.json || true; tspc -p tsconfig.build.json || true",
    "build:clean": "rm -rf build lib",
    "e2e": "npm run build && vitest run -c vitest.integration.config.ts",
    "e2e:update": "npm run e2e -- -u",
    "prepublishOnly": "npm run lint && npm run build && npm run build:types",
    "start": "node build/index.js",
    "test": "vitest run -c vitest.units.config.ts",
    "test:coverage": "vitest run -c vitest.units.config.ts --coverage",
    "translate:eval": "node scripts/translate-eval.mjs",
    "translate:bench": "node scripts/translate-bench.mjs",
    "test:watch": "vitest -c vitest.units.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "lint": "lint",
    "lint:fix": "lint fix",
    "pre-commit": "lint-staged",
    "prepare": "husky || true",
    "lock": "npm install --no-workspaces --package-lock-only --ignore-scripts"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "git add"
    ]
  },
